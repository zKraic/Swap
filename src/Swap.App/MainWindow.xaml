<Window x:Class="Swap.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="Swap" Icon="Assets/swap.ico" Width="1120" Height="810" MinWidth="880" MinHeight="640" Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterScreen" Loaded="OnLoaded" Closing="OnClosing" SourceInitialized="OnSourceInitialized">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Grid x:Name="WindowRoot" Background="{DynamicResource WindowBg}">
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.RowSpan="3" Background="{DynamicResource Side}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,1,0"/>
  <StackPanel Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center"><Image Source="Assets/swap-logo.png" Width="26" Height="26"/><TextBlock Text="swap" FontSize="21" FontWeight="SemiBold" Margin="9,-2,0,0"/></StackPanel>
  <Grid Grid.Column="1"><TextBlock Text="GPU DRIVER UTILITY" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="28,0"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource Quiet}" Width="46" Padding="0" Click="Minimize" ToolTip="{DynamicResource minimize}" AutomationProperties.Name="{DynamicResource minimize}"/><Button Content="&#xE922;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource Quiet}" Width="46" Padding="0" Click="Maximize" ToolTip="{DynamicResource maximize}" AutomationProperties.Name="{DynamicResource maximize}"/><Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource Quiet}" Width="46" Padding="0" Click="CloseWindow" ToolTip="{DynamicResource close}" AutomationProperties.Name="{DynamicResource close}"/></StackPanel></Grid>
  <DockPanel Grid.Row="1" Margin="12,22,12,16">
   <StackPanel DockPanel.Dock="Bottom" Margin="10,0"><TextBlock x:Name="ModeLabel" Text="{DynamicResource portable}" Style="{StaticResource Label}"/><TextBlock x:Name="VersionLabel" Text="{DynamicResource preview}" Style="{StaticResource Caption}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
   <StackPanel>
    <RadioButton x:Name="HomeNav" AutomationProperties.Name="{DynamicResource home}" Style="{StaticResource Nav}" GroupName="Pages" Tag="Home" IsChecked="True" Checked="Navigate"><DockPanel LastChildFill="True"><TextBlock DockPanel.Dock="Left" Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,1,12,0"/><TextBlock Text="{DynamicResource home}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}"/></DockPanel></RadioButton>
    <RadioButton x:Name="CleanupNav" AutomationProperties.Name="{DynamicResource cleanup}" Style="{StaticResource Nav}" GroupName="Pages" Tag="Cleanup" Checked="Navigate"><DockPanel LastChildFill="True"><TextBlock DockPanel.Dock="Left" Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,1,12,0"/><TextBlock Text="{DynamicResource cleanup}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}"/></DockPanel></RadioButton>
    <RadioButton x:Name="LibraryNav" AutomationProperties.Name="{DynamicResource library}" Style="{StaticResource Nav}" GroupName="Pages" Tag="Library" Checked="Navigate"><DockPanel LastChildFill="True"><TextBlock DockPanel.Dock="Left" Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,1,12,0"/><TextBlock Text="{DynamicResource library}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}"/></DockPanel></RadioButton>
    <RadioButton x:Name="RecoveryNav" AutomationProperties.Name="{DynamicResource recovery}" Style="{StaticResource Nav}" GroupName="Pages" Tag="Recovery" Checked="Navigate"><DockPanel LastChildFill="True"><TextBlock DockPanel.Dock="Left" Text="&#xE777;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,1,12,0"/><TextBlock Text="{DynamicResource recovery}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}"/></DockPanel></RadioButton>
    <RadioButton x:Name="DiagnosticsNav" AutomationProperties.Name="{DynamicResource diagnostics}" Style="{StaticResource Nav}" GroupName="Pages" Tag="Diagnostics" Checked="Navigate"><DockPanel LastChildFill="True"><TextBlock DockPanel.Dock="Left" Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,1,12,0"/><TextBlock Text="{DynamicResource diagnostics}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}"/></DockPanel></RadioButton>
    <Border Height="1" Background="{DynamicResource Stroke}" Margin="12,16"/>
    <RadioButton x:Name="SettingsNav" AutomationProperties.Name="{DynamicResource settings}" Style="{StaticResource Nav}" GroupName="Pages" Tag="Settings" Checked="Navigate"><DockPanel LastChildFill="True"><TextBlock DockPanel.Dock="Left" Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,1,12,0"/><TextBlock Text="{DynamicResource settings}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}"/></DockPanel></RadioButton>
   </StackPanel>
  </DockPanel>
  <Grid Grid.Row="1" Grid.Column="1" Margin="24,14,24,12" MaxWidth="1360">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,8"><Button x:Name="DemoButton" DockPanel.Dock="Right" Style="{StaticResource Quiet}" Content="{DynamicResource demo}" Click="ToggleDemo"/><TextBlock x:Name="PageTitle" Text="{DynamicResource home}" FontSize="13" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></DockPanel>
   <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid>
     <StackPanel x:Name="HomePage">
      <TextBlock Text="{DynamicResource headline}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource intro}" Style="{StaticResource Caption}" Margin="0,5,0,10"/>
      <Border x:Name="DemoBanner" Background="{DynamicResource Subtle}" CornerRadius="6" Padding="12,5" Margin="0,0,0,8" Visibility="Collapsed"><TextBlock Text="{DynamicResource demoMode}" Foreground="{DynamicResource Accent}" FontSize="11" FontWeight="SemiBold"/></Border>
      <Border x:Name="SwapBanner" Style="{StaticResource Panel}" BorderBrush="{DynamicResource Accent}" Padding="16,12" Margin="0,0,0,12" Visibility="Collapsed"><StackPanel>
       <DockPanel><TextBlock DockPanel.Dock="Left" Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Accent}" Margin="0,2,10,0"/><TextBlock x:Name="SwapTitle" FontSize="15" FontWeight="SemiBold"/></DockPanel>
       <TextBlock x:Name="SwapText" Style="{StaticResource Caption}" FontSize="12" Margin="0,4,0,0"/>
       <WrapPanel Margin="0,10,0,0"><Button x:Name="SwapPrimaryButton" Style="{StaticResource Primary}" MinHeight="40" Click="SwapPrimary" Margin="0,0,8,4"/><Button x:Name="SwapSecondaryButton" Click="SwapSecondary" Margin="0,0,8,4"/><Button x:Name="SwapExtraButton" Style="{StaticResource Quiet}" Click="SwapExtra" Margin="0,0,8,4" Visibility="Collapsed"/><Button x:Name="SwapCancelButton" Content="{DynamicResource swapCancel}" Style="{StaticResource Quiet}" Click="SwapCancel" Margin="0,0,0,4"/></WrapPanel>
      </StackPanel></Border>
      <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="1.02*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource Panel}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource detected}" Style="{StaticResource Label}"/>
        <StackPanel Grid.Row="1" Margin="0,10,0,10">
         <Border Background="{DynamicResource Subtle}" Width="36" Height="36" CornerRadius="12" HorizontalAlignment="Left"><TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
         <TextBlock x:Name="GpuName" Text="{DynamicResource scanning}" FontSize="21" FontWeight="SemiBold" Margin="0,10,0,4"/>
         <TextBlock x:Name="GpuVendor" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock x:Name="GpuHealthSummary" Style="{StaticResource Caption}" FontSize="11" Margin="0,4,0,0"/>
         <ComboBox x:Name="GpuBox" Margin="0,12,0,0" SelectionChanged="GpuChanged" DisplayMemberPath="SelectionLabel" AutomationProperties.Name="{DynamicResource selectGpu}" Visibility="Collapsed"/>
        </StackPanel>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource driver}" Style="{StaticResource Caption}"/><TextBlock x:Name="DriverVersion" Text="—" FontSize="13" Margin="0,5,0,0"/></StackPanel><Border Background="{DynamicResource Subtle}" CornerRadius="5" Padding="10,5" VerticalAlignment="Bottom" Grid.Column="1"><TextBlock x:Name="DriverStatus" TextWrapping="NoWrap" Padding="0,0,6,0" Text="{DynamicResource pending}" Foreground="{DynamicResource Warning}" FontSize="11"/></Border></Grid>
       </Grid></Border>
       <Border Grid.Column="2" Style="{StaticResource Panel}"><StackPanel><DockPanel><TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Accent}" Margin="0,1,10,0"/><TextBlock Text="{DynamicResource automatic}" FontSize="18" FontWeight="SemiBold"/></DockPanel><TextBlock Text="{DynamicResource autoDetail}" Style="{StaticResource Caption}" Margin="0,8,0,14"/>
        <Button x:Name="RunButton" Style="{StaticResource Primary}" Content="{DynamicResource start}" Click="ExecuteAutomatic" IsEnabled="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
        <WrapPanel HorizontalAlignment="Center" Margin="0,3,0,7"><Button x:Name="DownloadButton" Content="{DynamicResource downloadOnly}" Style="{StaticResource Quiet}" Click="DownloadOnly"/><Button x:Name="PrepareButton" Content="{DynamicResource swapPrepare}" Style="{StaticResource Quiet}" Click="PrepareSwap" IsEnabled="False"/></WrapPanel>
        <TextBlock Text="{DynamicResource terms}" Style="{StaticResource Caption}" FontSize="11" LineHeight="17"/>
       </StackPanel></Border>
      </Grid>
      <Border Style="{StaticResource Panel}" Padding="16,12" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource system}" Style="{StaticResource Caption}" FontSize="11"/><TextBlock x:Name="SystemText" Text="Windows" Margin="0,5,8,0" FontSize="12"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource disk}" Style="{StaticResource Caption}" FontSize="11"/><TextBlock x:Name="DiskText" Text="—" Margin="0,5,0,0" FontSize="12"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource protection}" Style="{StaticResource Caption}" FontSize="11"/><TextBlock Text="{DynamicResource backupFirst}" Foreground="{DynamicResource Good}" Margin="0,5,0,0" FontSize="12"/></StackPanel></Grid></Border>
      <Border x:Name="AlertBorder" Background="{DynamicResource Subtle}" CornerRadius="8" Padding="16,12" Margin="0,0,0,16" Visibility="Collapsed"><DockPanel><Button x:Name="RestartButton" Content="{DynamicResource restart}" DockPanel.Dock="Right" Click="Restart" Visibility="Collapsed" Margin="12,0,0,0"/><Button x:Name="AdminButton" Content="{DynamicResource adminRetry}" DockPanel.Dock="Right" Click="Elevate" Visibility="Collapsed" Margin="12,0,0,0"/><TextBlock x:Name="AlertText" Foreground="{DynamicResource Warning}" FontSize="12" VerticalAlignment="Center"/></DockPanel></Border>
      <Border x:Name="WorkflowPanel" Style="{StaticResource Panel}" Padding="16,8"><StackPanel><DockPanel><TextBlock Text="{DynamicResource workflow}" FontSize="13" FontWeight="SemiBold"/><Button Content="{DynamicResource rescan}" Style="{StaticResource Quiet}" Padding="0" MinHeight="20" HorizontalAlignment="Right" Click="Analyze"/></DockPanel>
       <UniformGrid Columns="5" Margin="0,8,0,0">
        <StackPanel><TextBlock x:Name="Step1" Text="01" Foreground="{DynamicResource Muted}" FontSize="17"/><TextBlock Text="{DynamicResource search}" Style="{StaticResource Caption}" FontSize="11" Margin="0,4,8,0"/></StackPanel>
        <StackPanel><TextBlock x:Name="Step2" Text="02" Foreground="{DynamicResource Muted}" FontSize="17"/><TextBlock Text="{DynamicResource download}" Style="{StaticResource Caption}" FontSize="11" Margin="0,4,8,0"/></StackPanel>
        <StackPanel><TextBlock x:Name="Step3" Text="03" Foreground="{DynamicResource Muted}" FontSize="17"/><TextBlock Text="{DynamicResource backup}" Style="{StaticResource Caption}" FontSize="11" Margin="0,4,8,0"/></StackPanel>
        <StackPanel><TextBlock x:Name="Step4" Text="04" Foreground="{DynamicResource Muted}" FontSize="17"/><TextBlock Text="{DynamicResource install}" Style="{StaticResource Caption}" FontSize="11" Margin="0,4,8,0"/></StackPanel>
        <StackPanel><TextBlock x:Name="Step5" Text="05" Foreground="{DynamicResource Muted}" FontSize="17"/><TextBlock Text="{DynamicResource verify}" Style="{StaticResource Caption}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
       </UniformGrid>
       <TextBlock x:Name="OfferText" Style="{StaticResource Caption}" Margin="0,18,0,0" Visibility="Collapsed"/>
      </StackPanel></Border>
      <Expander x:Name="CleanupPreview" Header="{DynamicResource cleanupPreview}" Margin="2,10,2,0"><StackPanel><TextBlock Text="{DynamicResource scope}" Style="{StaticResource Caption}" FontSize="11"/><TextBlock x:Name="CleanupText" Style="{StaticResource Caption}" FontSize="11" Margin="0,8,0,0"/></StackPanel></Expander>
     </StackPanel>
     <StackPanel x:Name="CleanupPage" Visibility="Collapsed">
      <TextBlock Text="{DynamicResource cleanupTitle}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource cleanupIntro}" Style="{StaticResource Caption}" Margin="0,5,0,14"/>
      <Border Style="{StaticResource Panel}"><StackPanel>
       <DockPanel><Button Content="{DynamicResource cleanupAnalyze}" Click="AnalyzeCleanup" DockPanel.Dock="Right"/><TextBlock Text="{DynamicResource cleanupBrands}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
       <WrapPanel Margin="0,14,0,0"><CheckBox x:Name="CleanNvidia" Content="NVIDIA" Click="CleanupVendorChanged"/><CheckBox x:Name="CleanAmd" Content="AMD" Click="CleanupVendorChanged"/><CheckBox x:Name="CleanIntel" Content="Intel" Click="CleanupVendorChanged"/></WrapPanel>
       <TextBlock x:Name="CleanupNotes" Style="{StaticResource Caption}" FontSize="11" Margin="0,10,0,0" Visibility="Collapsed"/>
       <TextBlock x:Name="CleanupEmpty" Text="{DynamicResource cleanupNone}" Style="{StaticResource Caption}" Margin="0,16,0,8"/>
       <ListBox x:Name="CleanupList" MaxHeight="330" Margin="0,12,0,12" AutomationProperties.Name="{DynamicResource cleanup}" Visibility="Collapsed">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,1"/></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate><DockPanel><CheckBox IsChecked="{Binding Selected,Mode=TwoWay}" IsEnabled="{Binding Editable}" Margin="0,1,10,0" VerticalAlignment="Top" AutomationProperties.Name="{Binding Title}" Click="CleanupItemChanged"/><TextBlock DockPanel.Dock="Right" Text="{Binding Size}" Style="{StaticResource Caption}" FontSize="11" Margin="12,0,0,0"/><StackPanel><TextBlock Text="{Binding Title}" FontSize="12"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="11" LineHeight="17"/></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       <TextBlock x:Name="CleanupSummary" FontSize="12" Margin="0,0,0,12"/>
       <WrapPanel><Button x:Name="CleanupRunButton" Content="{DynamicResource cleanupRun}" Style="{StaticResource Primary}" Click="RunCleanup" IsEnabled="False" Margin="0,0,10,10"/><Button Content="{DynamicResource cleanupUndo}" Click="UndoCleanup" Margin="0,0,10,10"/><Button x:Name="FreeBackupsButton" Style="{StaticResource Quiet}" Click="FreeBackups" Margin="0,0,0,10" Visibility="Collapsed"/></WrapPanel>
      </StackPanel></Border>
      <Expander x:Name="CleanupKeptPanel" Header="{DynamicResource cleanupKept}" Margin="0,12,0,0" Visibility="Collapsed"><TextBlock x:Name="CleanupKeptText" FontSize="12" LineHeight="20" Margin="12,8"/></Expander>
      <Border Style="{StaticResource Panel}" Margin="0,16,0,0"><StackPanel>
       <DockPanel><Button x:Name="FreeSpaceButton" Content="{DynamicResource freeSpaceRun}" Click="FreeSpace" IsEnabled="False" DockPanel.Dock="Right"/><TextBlock Text="{DynamicResource freeSpace}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
       <TextBlock x:Name="FreeSpaceText" Text="—" Margin="0,12,0,0" FontSize="12"/><TextBlock Text="{DynamicResource freeSpaceHint}" Style="{StaticResource Caption}" FontSize="11" Margin="0,4,0,0"/>
      </StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="LibraryPage" Visibility="Collapsed"><TextBlock Text="{DynamicResource offlineTitle}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource offlineIntro}" Style="{StaticResource Caption}" Margin="0,5,0,14"/><Border Style="{StaticResource Panel}"><StackPanel><DockPanel><Button Content="{DynamicResource import}" Style="{StaticResource Primary}" Click="ChoosePackage" DockPanel.Dock="Right"/><TextBlock Text="{DynamicResource files}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock x:Name="VaultEmpty" Text="{DynamicResource emptyLibrary}" Style="{StaticResource Caption}" Margin="0,22"/><ListBox x:Name="VaultList" Margin="0,16,0,20" MaxHeight="300" DisplayMemberPath="Label" AutomationProperties.Name="{DynamicResource library}"/><WrapPanel><Button Content="{DynamicResource offlineInstall}" Click="InstallSaved" Margin="0,0,10,10"/><Button Content="{DynamicResource openFolder}" Click="OpenVault" Margin="0,0,0,10"/></WrapPanel></StackPanel></Border><Button Content="{DynamicResource suiteLink}" Style="{StaticResource Quiet}" Click="Official" HorizontalAlignment="Left" Margin="0,12"/><TextBlock Text="{DynamicResource notLatest}" Style="{StaticResource Caption}"/></StackPanel>
     <StackPanel x:Name="RecoveryPage" Visibility="Collapsed"><TextBlock Text="{DynamicResource recoveryTitle}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource recoveryIntro}" Style="{StaticResource Caption}" Margin="0,5,0,14"/><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="{DynamicResource backups}" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="HistoryEmpty" Text="{DynamicResource emptyHistory}" Style="{StaticResource Caption}" Margin="0,18"/><ListBox x:Name="BackupList" DisplayMemberPath="Label" MaxHeight="150" Margin="0,12,0,18" AutomationProperties.Name="{DynamicResource backups}"/><WrapPanel><Button x:Name="CreateBackupButton" Content="{DynamicResource backupCreate}" Click="CreateBackup" Margin="0,0,10,10"/><Button Content="{DynamicResource restore}" Style="{StaticResource Primary}" Click="RestoreBackup" Margin="0,0,10,10"/><Button Content="{DynamicResource openFolder}" Click="OpenSessions" Margin="0,0,0,10"/></WrapPanel><TextBlock Text="{DynamicResource restoreNote}" Style="{StaticResource Caption}" Margin="0,12,0,0"/></StackPanel></Border><Border Style="{StaticResource Panel}" Margin="0,16,0,0"><StackPanel><TextBlock Text="{DynamicResource history}" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="HistoryText" Style="{StaticResource Caption}" Margin="0,14,0,0"/></StackPanel></Border></StackPanel>
     <StackPanel x:Name="DiagnosticsPage" Visibility="Collapsed">
 <TextBlock Text="{DynamicResource diagnosticsTitle}" FontSize="26" FontWeight="SemiBold"/>
 <TextBlock Text="{DynamicResource diagnosticsIntro}" Style="{StaticResource Caption}" Margin="0,5,0,14"/>
 <Border Style="{StaticResource Panel}" Padding="18,14"><StackPanel>
  <TextBlock x:Name="HealthText" FontSize="12" LineHeight="20"/>
  <WrapPanel Margin="0,14,0,0"><Button Content="{DynamicResource healthRefresh}" Click="RefreshHealth" Margin="0,0,8,6"/><Button Content="{DynamicResource export}" Click="ExportReport" Margin="0,0,8,6"/><Button Content="{DynamicResource validationExport}" Click="ExportValidation" Margin="0,0,8,6"/><Button Content="{DynamicResource healthRecovery}" Click="ViewRecovery" Margin="0,0,0,6"/></WrapPanel>
 </StackPanel></Border>
 <Expander x:Name="GamesDisclosure" Header="{DynamicResource gamesTitle}" Margin="0,12,0,0"><StackPanel Margin="12,8"><TextBlock x:Name="GamesText" Text="{DynamicResource gamesUnknown}" FontSize="12" LineHeight="20"/><Button Content="{DynamicResource githubForm}" Style="{StaticResource Quiet}" Click="OpenGithubForm" HorizontalAlignment="Left" Padding="0,8" Margin="0,6,0,0"/></StackPanel></Expander>
 <Expander x:Name="DisplayDisclosure" Header="{DynamicResource displayTitle}" Margin="0,8,0,0"><StackPanel Margin="12,8"><TextBlock x:Name="DisplayText" FontSize="12" LineHeight="20"/><WrapPanel x:Name="RefreshPanel" Margin="0,10,0,0"/><Border x:Name="RefreshConfirm" Background="{DynamicResource Subtle}" CornerRadius="8" Padding="14,10" Margin="0,8,0,0" Visibility="Collapsed"><DockPanel><Button x:Name="RefreshRevertButton" Content="{DynamicResource refreshRevert}" Click="RevertRefresh" DockPanel.Dock="Right" Margin="8,0,0,0"/><Button Content="{DynamicResource refreshKeep}" Style="{StaticResource Primary}" MinHeight="40" Click="KeepRefresh" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBlock x:Name="RefreshAsk" FontSize="12" VerticalAlignment="Center"/></DockPanel></Border></StackPanel></Expander>
 <Expander x:Name="EventDisclosure" Header="{DynamicResource eventTitle}" Margin="0,8,0,0"><TextBlock x:Name="EventText" FontSize="12" LineHeight="20" Margin="12,8"/></Expander>
 <Expander x:Name="CheckpointDisclosure" Header="{DynamicResource checkpointTitle}" Margin="0,8,0,0"><StackPanel Margin="12,8"><TextBlock x:Name="ComparisonText" FontSize="12" LineHeight="20"/><Button Content="{DynamicResource checkpointSave}" Click="SaveCheckpoint" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></Expander>
 <Expander x:Name="LastComparisonPanel" Header="{DynamicResource lastComparison}" Visibility="Collapsed" Margin="0,8,0,0"><TextBlock x:Name="LastComparisonText" FontSize="12" LineHeight="20" Margin="12,8"/></Expander>
 <TextBlock Text="{DynamicResource healthScope}" Style="{StaticResource Caption}" FontSize="11" Margin="0,12,0,0"/>
 <Expander Header="{DynamicResource details}" Margin="0,8,0,0"><WrapPanel><Button Content="{DynamicResource directx}" Click="Dxdiag" Margin="0,8,8,0"/><Button Content="{DynamicResource events}" Click="Events" Margin="0,8,8,0"/><Button Content="{DynamicResource openFolder}" Click="OpenReports" Margin="0,8,0,0"/></WrapPanel></Expander>
</StackPanel>
     <StackPanel x:Name="SettingsPage" Visibility="Collapsed"><TextBlock Text="{DynamicResource settingsTitle}" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,14"/><Border Style="{StaticResource Panel}"><StackPanel><Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource language}" VerticalAlignment="Center"/><ComboBox x:Name="LanguageBox" Grid.Column="1" SelectionChanged="PreferenceChanged" AutomationProperties.Name="{DynamicResource language}"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource appearance}" VerticalAlignment="Center"/><ComboBox x:Name="ThemeBox" Grid.Column="1" SelectionChanged="PreferenceChanged" AutomationProperties.Name="{DynamicResource appearance}"/></Grid></StackPanel></Border><Border Style="{StaticResource Panel}" Margin="0,16,0,0"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource previous}" VerticalAlignment="Center"/><ComboBox x:Name="SourceBox" Grid.Column="1" SelectionChanged="PreferenceChanged" AutomationProperties.Name="{DynamicResource previous}"/></Grid><TextBlock Text="{DynamicResource previousHint}" Style="{StaticResource Caption}" Margin="0,14,0,0"/><CheckBox x:Name="DeepCleanBox" Content="{DynamicResource cleanupAuto}" Margin="0,16,0,0" Click="DeepCleanChanged"/><TextBlock Text="{DynamicResource cleanupAutoHint}" Style="{StaticResource Caption}" FontSize="11" Margin="26,6,0,0"/></StackPanel></Border><Expander Header="{DynamicResource storage}" Margin="0,12,0,0"><Border Style="{StaticResource Panel}"><StackPanel><DockPanel><Button Content="{DynamicResource openFolder}" Click="OpenData" DockPanel.Dock="Right"/><TextBlock Text="{DynamicResource storage}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock Text="{DynamicResource storageHint}" Style="{StaticResource Caption}" Margin="0,12,0,12"/><TextBlock x:Name="StoragePath" Style="{StaticResource Caption}" FontSize="11"/></StackPanel></Border></Expander><Expander Header="{DynamicResource about}" Margin="0,10,0,0"><StackPanel><TextBlock Text="{DynamicResource about}" Margin="0,24,0,8" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource support}" Style="{StaticResource Caption}"/><TextBlock Text="{DynamicResource noAutoReboot}" Style="{StaticResource Caption}" Margin="0,4,0,0"/><WrapPanel Margin="0,12,0,0"><Button Content="{DynamicResource license}" Style="{StaticResource Quiet}" Click="OpenDocumentation"/><Button Content="{DynamicResource sourceLink}" Style="{StaticResource Quiet}" Click="OpenSources"/></WrapPanel></StackPanel></Expander></StackPanel>
    </Grid>
   </ScrollViewer>
   <Expander x:Name="Details" Grid.Row="2" Header="{DynamicResource details}" Margin="0,4,0,0" Visibility="Collapsed"><TextBox x:Name="LogBox" IsReadOnly="True" Background="{DynamicResource Side}" Foreground="{DynamicResource Muted}" BorderThickness="0" FontFamily="Consolas" FontSize="11" Height="130" Padding="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{DynamicResource details}"/></Expander>
  </Grid>
